# Copy file này thành .env rồi chỉnh giá trị:  cp .env.example .env

# ==================== App ====================
# development | production
APP_ENV=development
PORT=8080

# ==================== Database ====================
# sqlite | postgres
DB_DRIVER=sqlite
# silent | error | warn | info  (info = log toàn bộ câu SQL)
DB_LOG_LEVEL=warn

# --- SQLite (dùng khi DB_DRIVER=sqlite) ---
SQLITE_PATH=conduit.db

# --- PostgreSQL (dùng khi DB_DRIVER=postgres) ---
# Nếu đặt DATABASE_URL thì các biến DB_HOST... bên dưới sẽ bị bỏ qua.
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/conduit?sslmode=disable
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=conduit
DB_SSLMODE=disable
DB_TIMEZONE=UTC

# ==================== JWT ====================
# Bắt buộc. Production yêu cầu tối thiểu 32 ký tự (tạo nhanh: openssl rand -hex 32)
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN=72h
JWT_ISSUER=conduit

# ==================== CORS ====================
# Danh sách origin, phân tách bằng dấu phẩy. "*" = cho phép tất cả.
CORS_ALLOWED_ORIGINS=*
